FISH_AUDIO_API_KEY=your_fish_audio_api_key_here

# Translation backend — Groq > Gemini > Ollama (auto-selected by which key is present)
# Groq: free tier, fast, no billing required — https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
# Gemini: free tier via Google AI Studio — https://aistudio.google.com/apikey
# GEMINI_API_KEY=your_gemini_api_key_here

# Optional overrides:
# GROQ_MODEL=llama-3.3-70b-versatile   # default Groq model
# GEMINI_MODEL=gemini-2.0-flash        # default Gemini model
# TRANSLATION_BACKEND=groq             # force Groq
# TRANSLATION_BACKEND=gemini           # force Gemini
# TRANSLATION_BACKEND=ollama           # force fully-local Ollama
# OLLAMA_MODEL=llama3.2:latest         # Ollama model (only used when backend=ollama)

# Phase B — overlapping speaker handling (pyannote diarization).
# 1. Create an account at huggingface.co
# 2. Accept model terms at huggingface.co/pyannote/speaker-diarization-3.1
# 3. Generate a token at huggingface.co/settings/tokens
# HF_TOKEN=hf_...
