FISH_AUDIO_API_KEY=your_fish_audio_api_key_here

# Ollama model for translation (default: llama3.2:latest).
# llama3.2:latest (3B, 2 GB) — reliable segment boundaries, recommended.
# llama3.2:1b    (1B, 1.3 GB) — faster but may merge segments; use with caution.
# Run `ollama pull <model>` to download.
# OLLAMA_MODEL=llama3.2:latest
